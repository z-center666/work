<script src="h5-shared-data.js"></script>
<script>
/* ============================================================
 * 外卖代下单 · 客服端 H5
 * 流程：① 老外档案 → ② 收货地址 → ③ 选店点菜 → 老外确认
 * ============================================================ */

// ---------- 全局状态 ----------
let TOURIST = null;          // 当前老外
let curStep = 1;             // 当前步骤 1/2/3
let addrTab = 'exist';       // 地址 tab: exist / rec
let selectedAddr = null;     // 已选地址对象
let selectedRec = null;      // 已选推荐地址原始对象
let addrConfirmed = false;   // 老外是否已确认地址
let addrCardId = null;       // 当前地址卡片 ID
let orderCardId = null;      // 当前订单卡片 ID
let cart = [];               // 购物车 [{shopId, shopName, item, qty}]
let expandedShop = null;     // 当前展开菜单的店铺 id
let orderConfirmed = false;  // 老外是否已确认订单
let orderPushed = false;     // 订单是否已推送
let addrPushed = false;      // 地址是否已推送
let cardSeq = 0;             // 硬件卡片序号

// ---------- 工具 ----------
function $(id){ return document.getElementById(id); }
function show(id){ $(id).classList.remove('hidden'); }
function hide(id){ $(id).classList.add('hidden'); }
function esc(s){ return escHtml(s); }
function money(n){ return fmtMoney(n); }

let toastTimer = null;
function toast(msg, ms){
  ms = ms || 2400;
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){ t.classList.remove('show'); }, ms);
}

// ---------- 初始化 ----------
function init(){
  // 自动获取第 1 位老外
  TOURIST = TOURISTS[0];
  renderTourist();
  renderStep1();
  renderAddrList();
  renderRecList('');
  renderShops();
  bindEvents();
  gotoStep(1);
}

// ---------- 老外档案 ----------
function renderTourist(){
  $('tName').textContent    = TOURIST.name;
  $('tSub').textContent     = TOURIST.lang + ' · ' + TOURIST.passport;
  $('tUserId').textContent  = userIdOf(TOURIST);
  $('tLang').textContent    = TOURIST.lang;
  $('tPassport').textContent= TOURIST.passport;
  $('tPhone').textContent   = maskPhone(TOURIST.phone);
  $('tDevice').textContent  = TOURIST.deviceNo;
  $('tLngLat').textContent  = TOURIST.lng.toFixed(4) + ', ' + TOURIST.lat.toFixed(4);
  $('tCity').textContent    = TOURIST.city;
  $('tBalance').textContent = TOURIST.balance;
  $('tBalance2').textContent= TOURIST.balance;
  $('tBalance3').textContent= TOURIST.balance;
}

// ---------- 步骤条 ----------
function updateStepbar(){
  document.querySelectorAll('.step-item').forEach(function(el){
    var s = parseInt(el.dataset.step);
    el.classList.remove('active','done');
    if(s < curStep)  el.classList.add('done');
    if(s === curStep) el.classList.add('active');
    if(s < curStep)  el.querySelector('.dot').textContent = '✓';
    else             el.querySelector('.dot').textContent = s;
  });
}

function gotoStep(n){
  curStep = n;
  updateStepbar();
  hide('step1'); hide('step2'); hide('step3');
  hide('cartBar'); hide('actionBar');
  $('pageBody').className = 'page-body';

  if(n === 1){
    show('step1');
  } else if(n === 2){
    show('step2');
    show('actionBar');
    $('pageBody').classList.add('has-action');
    resetAddrStep();
  } else if(n === 3){
    show('step3');
    show('cartBar');
    show('actionBar');
    $('pageBody').classList.add('has-cart');
    resetOrderStep();
  }
}

// ---------- 第②步：地址 ----------
function resetAddrStep(){
  addrConfirmed  = false;
  addrPushed     = false;
  addrCardId     = null;
  selectedAddr   = null;
  selectedRec    = null;
  // 清空选择状态
  document.querySelectorAll('.addr-item').forEach(function(el){ el.classList.remove('selected'); });
  hide('completeForm');
  $('recSearchInput').value = '';
  renderRecList('');
  // 回显忌口偏好
  $('dietInput').value = TOURIST.diet || '';
  $('prefInput').value = TOURIST.pref || '';
  // 清空硬件卡片
  $('hwCards2').innerHTML = '<div class="hw-empty">暂无推送卡片</div>';
  hide('hwPanel2');
  // 恢复按钮
  setMainBtn('推送收货地址、忌口偏好给老外确认', false, false);
}

function renderAddrList(){
  var html = '';
  TOURIST.addrs.forEach(function(a, i){
    html += '<div class="addr-item" data-idx="'+i+'" data-type="exist">'
      + '<div class="addr-label">'+esc(a.label)+'</div>'
      + '<div class="addr-detail">'+esc(a.detail)+'</div>'
      + '<div class="addr-contact">'+esc(a.contact)+'</div>'
      + (a.note ? '<div class="addr-note">'+esc(a.note)+'</div>' : '')
      + '</div>';
  });
  $('addrListExist').innerHTML = html;
}

function renderRecList(kw){
  kw = (kw || '').toLowerCase();
  var list = ADDR_RECOMMENDS.filter(function(r){
    return !kw || r.label.toLowerCase().indexOf(kw) >= 0 || r.detail.toLowerCase().indexOf(kw) >= 0;
  });
  if(!list.length){
    $('addrListRec').innerHTML = '<div class="rec-empty">未找到匹配地址</div>';
    return;
  }
  var html = '';
  list.forEach(function(r){
    html += '<div class="addr-item" data-id="'+r.id+'" data-type="rec">'
      + '<div class="addr-label">'+esc(r.label)+'</div>'
      + '<div class="addr-detail">'+esc(r.detail)+'</div>'
      + '</div>';
  });
  $('addrListRec').innerHTML = html;
}

function switchAddrTab(tab){
  addrTab = tab;
  document.querySelectorAll('.addr-tab').forEach(function(el){
    el.classList.toggle('active', el.dataset.tab === tab);
  });
  if(tab === 'exist'){ show('addrTabExist'); hide('addrTabRec'); }
  else              { hide('addrTabExist'); show('addrTabRec'); }
}

// 点击地址卡片
function onAddrItemClick(el){
  if(addrPushed && !addrConfirmed){
    toast('已推送老外，等待确认中…');
    return;
  }
  if(addrConfirmed){
    toast('老外已确认，如需修改请重新进入');
    return;
  }

  document.querySelectorAll('.addr-item').forEach(function(x){ x.classList.remove('selected'); });
  el.classList.add('selected');

  var type = el.dataset.type;
  if(type === 'exist'){
    selectedAddr = TOURIST.addrs[parseInt(el.dataset.idx)];
    selectedRec  = null;
    hide('completeForm');
  } else {
    var rec = ADDR_RECOMMENDS.find(function(r){ return r.id === el.dataset.id; });
    selectedRec  = rec;
    selectedAddr = null;
    show('completeForm');
    $('cfAddrLabel').textContent = rec.label;
    // 预填联系人
    var parts = (TOURIST.addrs[0].contact || '').split(' / ');
    $('cfContact').value = parts[0] || TOURIST.name;
    $('cfPhone').value   = TOURIST.phone || '';
    $('cfDetail').value  = '';
  }
}

// 校验推荐地址补全
function validateRecForm(){
  if(!selectedRec) return {ok:false, msg:'请先选择推荐地址'};
  var d = $('cfDetail').value.trim();
  var c = $('cfContact').value.trim();
  var p = $('cfPhone').value.trim();
  if(!d) return {ok:false, msg:'请填写详细地址（楼栋/楼层/房号）'};
  if(!c) return {ok:false, msg:'请填写收货人姓名'};
  if(!p || p.length < 11) return {ok:false, msg:'请填写正确的 11 位手机号'};
  return {ok:true, detail:d, contact:c, phone:p};
}

// 获取当前选中的完整地址对象
function getSelectedAddrObj(){
  if(selectedAddr) return selectedAddr;
  if(selectedRec){
    var v = validateRecForm();
    if(!v.ok) return null;
    return {
      label:   selectedRec.label + ' ' + v.detail,
      detail:  selectedRec.detail,
      contact: v.contact + ' / ' + v.phone,
      note:    $('dietInput').value.trim() ? '忌口：' + $('dietInput').value.trim() : '',
      lng:     selectedRec.lng,
      lat:     selectedRec.lat
    };
  }
  return null;
}

// 推送地址卡片
function pushAddrCard(){
  if(addrPushed && !addrConfirmed){
    toast('已推送，等待老外确认中…');
    return;
  }

  var addr = getSelectedAddrObj();
  if(!addr){
    if(selectedRec){
      var v = validateRecForm();
      toast(v.msg);
    } else {
      toast('请先选择收货地址');
    }
    return;
  }

  var diet = $('dietInput').value.trim();
  var pref = $('prefInput').value.trim();

  addrPushed = true;
  addrConfirmed = false;
  cardSeq++;
  addrCardId = 'card_addr_' + cardSeq;

  // 按钮 busy
  setMainBtn('推送中…', true, true);

  setTimeout(function(){
    setMainBtn('已推送 · 等待老外确认', false, true);
    $('mainActionBtn').disabled = true;

    // 硬件面板显示卡片
    show('hwPanel2');
    $('hwDevice2').textContent = TOURIST.deviceNo;
    addHwCard('hwCards2', {
      id:       addrCardId,
      type:     'addr',
      typeLabel:'收货信息',
      status:   'pending',
      rows: [
        {k:'地址', v: addr.label},
        {k:'详情', v: addr.detail},
        {k:'联系人', v: addr.contact},
        {k:'忌口', v: diet || '无'},
        {k:'偏好', v: pref || '无'}
      ],
      onConfirm: onAddrConfirm,
      onReject:  onAddrReject
    });

    toast('卡片①（收货信息）已推送老外，等待确认（9 分 50 秒内有效）', 3200);
  }, 900);
}

// 老外确认地址
function onAddrConfirm(cardId){
  if(cardId !== addrCardId) return;
  addrConfirmed = true;
  updateHwCardStatus('hwCards2', cardId, 'confirmed');
  toast('老外已确认，进入选菜');
  setTimeout(function(){ gotoStep(3); }, 600);
}

// 老外拒绝地址
function onAddrReject(cardId){
  if(cardId !== addrCardId) return;
  addrPushed = false;
  addrConfirmed = false;
  addrCardId = null;
  updateHwCardStatus('hwCards2', cardId, 'rejected');
  setMainBtn('推送收货地址、忌口偏好给老外确认', false, false);
  toast('老外已拒绝，可修改后重推');
}

// ---------- 第③步：选店点菜 ----------
function resetOrderStep(){
  orderConfirmed = false;
  orderPushed    = false;
  orderCardId    = null;
  cart           = [];
  expandedShop   = null;
  // 清空备注
  $('orderRemark').value = '配送完成一定要打电话' + (TOURIST.pref ? '；' + TOURIST.pref : '');
  $('remarkCount').textContent = $('orderRemark').value.length;
  // 清空硬件
  $('hwCards3').innerHTML = '<div class="hw-empty">暂无推送卡片</div>';
  hide('hwPanel3');
  // 渲染
  renderShops();
  renderCartBar();
  setMainBtn('推送菜品信息给老外确认', false, false);
  $('mainActionBtn').disabled = true;
}

function renderShops(){
  var html = '';
  SHOPS.forEach(function(s){
    var inCart = cart.length > 0 && cart[0].shopId === s.id;
    var otherShopInCart = cart.length > 0 && cart[0].shopId !== s.id;
    html += '<div class="shop-card'+(expandedShop===s.id?' expanded':'')+'" data-id="'+s.id+'">'
      + '<div class="shop-head" data-shop="'+s.id+'">'
      +   '<div class="shop-logo" style="background:linear-gradient(135deg,'+s.logo.a+','+s.logo.b+')">'+s.logo.e+'</div>'
      +   '<div class="shop-info">'
      +     '<div class="shop-name">'+esc(s.name)+'</div>'
      +     '<div class="shop-meta">'
      +       '<span class="score">★ '+s.score+'</span>'
      +       '<span class="sep"></span>'
      +       '<span>月售 '+s.monthlySales+'</span>'
      +       '<span class="sep"></span>'
      +       '<span>'+s.distance+' · '+s.eta+'</span>'
      +     '</div>'
      +     '<div class="shop-bottom">'
      +       '<div class="shop-fees"><span class="fee">'+esc(s.deliveryFee)+'</span> · 起送 ¥'+s.minOrder+'</div>'
      +       '<div class="shop-arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></div>'
      +     '</div>'
      +   '</div>'
      + '</div>'
      + '<div class="shop-menu'+(expandedShop===s.id?'':' hidden')+'" id="menu-'+s.id+'">';

    s.menu.forEach(function(m, mi){
      var qty = getCartQty(s.id, mi);
      html += '<div class="menu-item">'
        +   '<div class="menu-info">'
        +     '<div class="menu-name">'+esc(m.name)+'</div>'
        +     '<div class="menu-spec">'+esc(m.spec)+'</div>'
        +     '<div class="menu-desc">'+esc(m.desc)+'</div>'
        +   '</div>'
        +   '<div class="menu-right">'
        +     '<div class="menu-price">'+money(m.price)+'</div>'
        +     (qty > 0
              ? '<div class="cart-qty">'
                + '<button onclick="decQty(\''+s.id+'\','+mi+')">−</button>'
                + '<span class="qty-num">'+qty+'</span>'
                + '<button onclick="incQty(\''+s.id+'\','+mi+')">+</button>'
                + '</div>'
              : '<button class="menu-add'+(otherShopInCart?' disabled':'')+'" '
                + (otherShopInCart
                    ? 'onclick="toast(\'闪购不支持跨店铺下单\')"'
                    : 'onclick="addToCart(\''+s.id+'\','+mi+')"')
                + '>+</button>')
        +   '</div>'
        + '</div>';
    });

    html += '</div></div>';
  });
  $('shopList').innerHTML = html;
}

// 展开/收起店铺菜单
function toggleShop(shopId){
  if(expandedShop === shopId){
    expandedShop = null;
  } else {
    expandedShop = shopId;
  }
  renderShops();
}

// 购物车操作
function getCartQty(shopId, menuIdx){
  var found = cart.filter(function(c){ return c.shopId===shopId && c.menuIdx===menuIdx; });
  return found.length ? found[0].qty : 0;
}

function addToCart(shopId, menuIdx){
  if(orderPushed && !orderConfirmed){
    toast('已推送老外，等待确认中…');
    return;
  }
  if(orderConfirmed){
    toast('老外已确认，如需修改请重新进入');
    return;
  }
  // 同店限制
  if(cart.length > 0 && cart[0].shopId !== shopId){
    toast('闪购不支持跨店铺下单');
    return;
  }
  var shop = SHOPS.find(function(s){ return s.id === shopId; });
  var item = shop.menu[menuIdx];
  var found = cart.filter(function(c){ return c.shopId===shopId && c.menuIdx===menuIdx; });
  if(found.length){
    found[0].qty++;
  } else {
    cart.push({shopId:shopId, shopName:shop.name, menuIdx:menuIdx, item:item, qty:1});
  }
  renderShops();
  renderCartBar();
}

function incQty(shopId, menuIdx){
  if(orderPushed && !orderConfirmed){ toast('已推送，等待老外确认…'); return; }
  var found = cart.filter(function(c){ return c.shopId===shopId && c.menuIdx===menuIdx; });
  if(found.length) found[0].qty++;
  renderShops();
  renderCartBar();
}

function decQty(shopId, menuIdx){
  if(orderPushed && !orderConfirmed){ toast('已推送，等待老外确认…'); return; }
  var found = cart.filter(function(c){ return c.shopId===shopId && c.menuIdx===menuIdx; });
  if(found.length){
    found[0].qty--;
    if(found[0].qty <= 0) cart = cart.filter(function(c){ return c !== found[0]; });
  }
  renderShops();
  renderCartBar();
}

function removeFromCart(shopId, menuIdx){
  cart = cart.filter(function(c){ return !(c.shopId===shopId && c.menuIdx===menuIdx); });
  renderShops();
  renderCartBar();
}

// 购物车金额计算
function calcCart(){
  var goods    = 0;
  var totalQty = 0;
  var shopId   = cart.length ? cart[0].shopId : null;
  var shop     = shopId ? SHOPS.find(function(s){ return s.id===shopId; }) : null;
  cart.forEach(function(c){
    goods    += c.item.price * c.qty;
    totalQty += c.qty;
  });
  var delivery = 0;
  if(shop){
    var m = shop.deliveryFee.match(/([\d.]+)/);
    delivery = m ? parseFloat(m[1]) : 0;
  }
  var service = Math.round(goods * 0.1 * 100) / 100;
  var total   = Math.round((goods + delivery + service) * 100) / 100;
  return {goods:goods, delivery:delivery, service:service, total:total, totalQty:totalQty, shop:shop};
}

function renderCartBar(){
  var c = calcCart();
  if(c.totalQty > 0){
    $('cartBadge').textContent = c.totalQty;
    show('cartBadge');
    $('cartShopName').textContent = c.shop ? c.shop.name : '';
    $('cartAmount').innerHTML = money(c.goods) + ' <small>合计约 '+money(c.total)+'</small>';
    $('mainActionBtn').disabled = false;
  } else {
    hide('cartBadge');
    $('cartShopName').textContent = '未选菜品';
    $('cartAmount').innerHTML = '¥0.00 <small>请添加菜品</small>';
    $('mainActionBtn').disabled = true;
  }
  // 刷新明细弹层
  renderCartSheet();
}

function renderCartSheet(){
  if(!cart.length){
    $('cartItemsList').innerHTML = '<div class="cart-empty">购物车为空</div>';
    $('cartSheetShop').textContent = '-';
    $('cartFeeDetail').innerHTML = '';
    return;
  }
  var c = calcCart();
  $('cartSheetShop').textContent = c.shop.name;
  var html = '';
  cart.forEach(function(item){
    html += '<div class="cart-item">'
      + '<div class="cart-item-info">'
      +   '<div class="cart-item-name">'+esc(item.item.name)+'</div>'
      +   '<div class="cart-item-price">'+money(item.item.price)+' × '+item.qty+' = '+money(item.item.price*item.qty)+'</div>'
      + '</div>'
      + '<div class="cart-qty">'
      +   '<button onclick="decQty(\''+item.shopId+'\','+item.menuIdx+')">−</button>'
      +   '<span class="qty-num">'+item.qty+'</span>'
      +   '<button onclick="incQty(\''+item.shopId+'\','+item.menuIdx+')">+</button>'
      +   '<button class="qty-del" onclick="removeFromCart(\''+item.shopId+'\','+item.menuIdx+')">🗑</button>'
      + '</div>'
      + '</div>';
  });
  $('cartItemsList').innerHTML = html;
  $('cartFeeDetail').innerHTML =
      '<div class="fee-row"><span>商品合计</span><span>'+money(c.goods)+'</span></div>'
    + '<div class="fee-row"><span>配送费</span><span>'+money(c.delivery)+'</span></div>'
    + '<div class="fee-row"><span>服务费（10%）</span><span>'+money(c.service)+'</span></div>'
    + '<div class="fee-row total"><span>总计</span><span class="v">'+money(c.total)+'</span></div>';
}

// ---------- 推送订单卡片 ----------
function pushOrderCard(){
  if(!cart.length){ toast('请先添加菜品'); return; }
  if(orderPushed && !orderConfirmed){ toast('已推送，等待老外确认…'); return; }

  var c       = calcCart();
  var addr    = getSelectedAddrObj();
  var remark  = $('orderRemark').value.trim();

  orderPushed = true;
  orderConfirmed = false;
  cardSeq++;
  orderCardId = 'card_order_' + cardSeq;

  setMainBtn('推送中…', true, true);

  setTimeout(function(){
    setMainBtn('已推送 · 等待老外确认', false, true);
    $('mainActionBtn').disabled = true;

    var itemRows = cart.map(function(item){
      return {k: item.item.name, v: '×'+item.qty+'  '+money(item.item.price * item.qty)};
    });
    itemRows.push({k:'备注', v: remark || '无'});
    itemRows.push({k:'地址', v: addr ? addr.label + ' ' + addr.detail : '-'});
    itemRows.push({k:'联系人', v: addr ? addr.contact : '-'});
    itemRows.push({k:'金额', v: '商品 '+money(c.goods)+' + 配送 '+money(c.delivery)+' + 服务 '+money(c.service)});

    show('hwPanel3');
    $('hwDevice3').textContent = TOURIST.deviceNo;
    addHwCard('hwCards3', {
      id:        orderCardId,
      type:      'order',
      typeLabel: '订单确认',
      status:    'pending',
      rows:      itemRows,
      moneyLine: '总计 '+money(c.total),
      onConfirm: onOrderConfirm,
      onReject:  onOrderReject
    });

    toast('卡片②（订单确认）已推送老外', 2800);
  }, 900);
}

// 老外确认订单
function onOrderConfirm(cardId){
  if(cardId !== orderCardId) return;
  orderConfirmed = true;
  updateHwCardStatus('hwCards3', cardId, 'confirmed');

  var c    = calcCart();
  var addr = getSelectedAddrObj();

  // 强制弹窗
  setTimeout(function(){
    $('confirmTitle').textContent = '老外已确认下单';
    $('confirmDesc').textContent  = '订单已提交至闪购，可在「外卖订单」查看进度';
    $('confirmSummary').innerHTML =
        '<div class="row"><span class="rk">店铺</span><span class="rv">'+esc(c.shop.name)+'</span></div>'
      + '<div class="row"><span class="rk">菜品</span><span class="rv">'+cart.map(function(x){return esc(x.item.name)+' ×'+x.qty;}).join('、')+'</span></div>'
      + '<div class="row"><span class="rk">地址</span><span class="rv">'+esc(addr ? addr.label : '-')+'</span></div>'
      + '<div class="row"><span class="rk">金额</span><span class="rv money">'+money(c.total)+'（商品 '+money(c.goods)+' + 配送 '+money(c.delivery)+' + 服务 '+money(c.service)+'）</span></div>';
    $('confirmMask').classList.add('show');
  }, 400);
}

// 老外拒绝订单
function onOrderReject(cardId){
  if(cardId !== orderCardId) return;
  orderPushed    = false;
  orderConfirmed = false;
  orderCardId    = null;
  updateHwCardStatus('hwCards3', cardId, 'rejected');
  setMainBtn('推送菜品信息给老外确认', false, false);
  $('mainActionBtn').disabled = false;
  toast('老外已拒绝，可修改后重推');
}

// 关闭确认弹窗 → 重置回第②步
$('confirmCloseBtn').addEventListener('click', function(){
  $('confirmMask').classList.remove('show');
  // 重置老外（模拟下一位）
  var idx = TOURISTS.indexOf(TOURIST);
  TOURIST = TOURISTS[(idx + 1) % TOURISTS.length];
  renderTourist();
  gotoStep(2);
  toast('已重置，可为下一位老外代下单');
});

// ---------- 硬件卡片 ----------
function addHwCard(containerId, opts){
  var container = $(containerId);
  // 清空空提示
  var emptyEl = container.querySelector('.hw-empty');
  if(emptyEl) emptyEl.remove();

  var card = document.createElement('div');
  card.className = 'hw-card';
  card.dataset.cardId = opts.id;

  var rowsHtml = '';
  opts.rows.forEach(function(r){
    rowsHtml += '<div class="row"><span class="rk">'+esc(r.k)+'</span><span class="rv">'+esc(r.v)+'</span></div>';
  });

  var opsHtml = '';
  if(opts.status === 'pending'){
    opsHtml = '<div class="hw-card-ops">'
      + '<button class="hw-btn-ok" onclick="hwConfirm(\''+containerId+'\',\''+opts.id+'\')">✓ 确认</button>'
      + '<button class="hw-btn-no" onclick="hwReject(\''+containerId+'\',\''+opts.id+'\')">✗ 拒绝</button>'
      + '</div>';
  }

  card.innerHTML =
      '<div class="hw-card-head">'
    +   '<span class="hw-card-type '+opts.type+'">'+esc(opts.typeLabel)+'</span>'
    +   '<span class="hw-card-status" data-status>'+statusLabel(opts.status)+'</span>'
    + '</div>'
    + '<div class="hw-card-body">'+rowsHtml
    +   (opts.moneyLine ? '<div class="money-line">'+esc(opts.moneyLine)+'</div>' : '')
    + '</div>'
    + opsHtml;

  // 保存回调
  card._onConfirm = opts.onConfirm;
  card._onReject  = opts.onReject;

  container.appendChild(card);
  container.scrollTop = container.scrollHeight;
}

function statusLabel(s){
  return s==='confirmed' ? '✓ 已确认' : s==='rejected' ? '✗ 已拒绝' : '⏳ 待确认';
}

function updateHwCardStatus(containerId, cardId, status){
  var card = document.querySelector('#'+containerId+' [data-card-id="'+cardId+'"]');
  if(!card) return;
  var st = card.querySelector('[data-status]');
  st.textContent = statusLabel(status);
  st.className = 'hw-card-status ' + status;
  // 移除按钮
  var ops = card.querySelector('.hw-card-ops');
  if(ops) ops.remove();
}

// 全局回调（硬件卡片按钮触发）
function hwConfirm(containerId, cardId){
  var card = document.querySelector('#'+containerId+' [data-card-id="'+cardId+'"]');
  if(card && card._onConfirm) card._onConfirm(cardId);
}
function hwReject(containerId, cardId){
  var card = document.querySelector('#'+containerId+' [data-card-id="'+cardId+'"]');
  if(card && card._onReject) card._onReject(cardId);
}

// ---------- 主按钮 ----------
function setMainBtn(text, busy, disabled){
  $('mainActionText').textContent = text;
  $('mainActionBtn').classList.toggle('busy', busy);
  $('mainActionBtn').disabled = disabled;
}

// 主按钮点击（根据步骤判断行为）
$('mainActionBtn').addEventListener('click', function(){
  if(curStep === 2) pushAddrCard();
  else if(curStep === 3) pushOrderCard();
});

// ---------- 事件绑定 ----------
function bindEvents(){
  // 地址 tab 切换
  document.querySelectorAll('.addr-tab').forEach(function(el){
    el.addEventListener('click', function(){ switchAddrTab(el.dataset.tab); });
  });

  // 地址列表点击（事件委托）
  $('addrListExist').addEventListener('click', function(e){
    var item = e.target.closest('.addr-item');
    if(item) onAddrItemClick(item);
  });
  $('addrListRec').addEventListener('click', function(e){
    var item = e.target.closest('.addr-item');
    if(item) onAddrItemClick(item);
  });

  // 推荐地址搜索
  $('recSearchInput').addEventListener('input', function(){
    renderRecList(this.value.trim());
  });

  // 店铺展开/收起（事件委托）
  $('shopList').addEventListener('click', function(e){
    var head = e.target.closest('.shop-head');
    if(head) toggleShop(head.dataset.shop);
  });

  // 购物车栏点击 → 打开明细弹层
  $('cartBar').addEventListener('click', function(e){
    if(e.target.closest('#cartGoBtn') || e.target.closest('.cart-icon') || e.target.closest('.cart-info')){
      $('cartSheetMask').classList.add('show');
      $('cartSheet').classList.add('show');
    }
  });
  $('cartSheetMask').addEventListener('click', function(){
    $('cartSheetMask').classList.remove('show');
    $('cartSheet').classList.remove('show');
  });

  // 备注字数统计
  $('orderRemark').addEventListener('input', function(){
    $('remarkCount').textContent = this.value.length;
  });
}

// 暴露给 HTML 内联事件
window.addToCart  = addToCart;
window.incQty     = incQty;
window.decQty     = decQty;
window.removeFromCart = removeFromCart;
window.hwConfirm  = hwConfirm;
window.hwReject   = hwReject;
window.toast      = toast;

// ---------- 启动 ----------
init();
</script>
