  </section>

  <!-- 详情视图 -->
  <section id="viewDetail" hidden>
    <div class="detail-head">
      <button class="back" id="btnBack" aria-label="返回">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M12.5 4L6.5 10l6 6" stroke="#262626" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="t">外卖订单详情</div>
    </div>
    <div class="detail-body" id="detailBody"></div>
  </section>

  <!-- 详情底部操作栏 -->
  <div class="detail-bar" id="detailBar" hidden></div>

  <!-- 底部导航 -->
  <nav class="tabbar">
    <a href="h5-外卖订单.html" class="active">
