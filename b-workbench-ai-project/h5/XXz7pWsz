<script>
/* ================================================================
 * 外卖订单 H5 · 客服视角
 * ================================================================ */

/* ---------- 常量 ---------- */
var PAGE_SIZE = 3;
var COMP_OK = {'已支付':1,'商家备餐中':1,'配送中':1,'已完成':1};          // 可补偿状态
var REFRESH_OK = {'已支付':1,'商家备餐中':1,'配送中':1};                    // 可刷新状态
var CURRENT_CS = '当前客服 13800138018';

var STATUS_STYLE = {
  '已支付':          {bg:'#E6F4FF', fg:'#0669FF', bd:'#91CAFF'},
  '商家备餐中':      {bg:'#FFFBE6', fg:'#D48806', bd:'#FFE58F'},
  '配送中':          {bg:'#FFF2E8', fg:'#FF6B35', bd:'#FFBB96'},
  '已完成':          {bg:'#F6FFED', fg:'#52C41A', bd:'#B7EB8F'},
  '已取消':          {bg:'#FAFAFA', fg:'#8C8C8C', bd:'#D9D9D9'},
  '下单或履约失败':  {bg:'#FFF1F0', fg:'#FF4D4F', bd:'#FFA39E'},
  '已退款':          {bg:'#F9F0FF', fg:'#722ED1', bd:'#D3ADF7'}
};

/* ---------- 状态 ---------- */
var state = {
  q:'', status:'', source:'', dateFrom:'', dateTo:'',
  page:1, detailId:null, compOrderId:null
};

/* ---------- 工具 ---------- */
function $(id){ return document.getElementById(id); }
function esc(s){ return escHtml(s); }
function badge(status, lg){
  var s = STATUS_STYLE[status] || {bg:'#FAFAFA',fg:'#8C8C8C',bd:'#D9D9D9'};
  return '<span class="badge' + (lg ? ' badge-lg' : '') + '" style="background:' + s.bg +
    ';color:' + s.fg + ';border-color:' + s.bd + '"><span class="dot"></span>' + esc(status) + '</span>';
}
function sumComp(o){
  var t = 0; (o.compensations || []).forEach(function(c){ t += Number(c.points) || 0; });
  return t;
}
function canComp(o){ return COMP_OK[o.status] && sumComp(o) < Number(o.money.total); }
function orderDate(o){
  var m = /(\d{4}-\d{2}-\d{2})/.exec(o.meta || '');
  return m ? m[1] : '';
}
function orderTimeStr(o){
  var m = /下单\s*(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})/.exec(o.meta || '');
  return m ? m[1] : (o.meta || '');
}
function toast(msg, ok){
  var t = $('toast');
  t.textContent = msg;
  t.className = 'toast show' + (ok ? ' ok' : '');
  clearTimeout(t._tm);
  t._tm = setTimeout(function(){ t.className = 'toast'; }, 2200);
}

/* ---------- 列表数据 ---------- */
function allOrders(){
  var arr = Object.keys(ORDERS).map(function(k){ return ORDERS[k]; });
  arr.sort(function(a,b){
    return orderTimeStr(b).localeCompare(orderTimeStr(a));
  });
  return arr;
}
function filtered(){
  var q = state.q.trim().toLowerCase();
  return allOrders().filter(function(o){
    if(q){
      var hay = [o.id, o.name, o.passport, o.deviceNo].join(' ').toLowerCase();
      if(hay.indexOf(q) < 0) return false;
    }
    if(state.status && o.status !== state.status) return false;
    if(state.source && o.source !== state.source) return false;
    var d = orderDate(o);
    if(state.dateFrom && d && d < state.dateFrom) return false;
    if(state.dateTo && d && d > state.dateTo) return false;
    return true;
  });
}

/* ---------- 列表渲染 ---------- */
function renderList(){
  var data = filtered();
  $('totalCnt').textContent = data.length;
  var show = data.slice(0, state.page * PAGE_SIZE);
  var html = '';

  if(!show.length){
    html = '<div class="list-empty">暂无符合条件的订单</div>';
  }else{
    show.forEach(function(o){
      var comp = canComp(o);
      html += '' +
      '<div class="order-card" data-id="' + esc(o.id) + '">' +
        '<div class="oc-row1">' +
          '<span class="oid mono">' + esc(o.id) + '</span>' +
          badge(o.status) +
        '</div>' +
        '<div class="oc-row2">' + esc(o.name) + ' · ' + esc(o.lang) + ' · ' +
          esc(maskPassport(o.passport)) + ' · ' + esc(maskPhone(o.phone)) + '</div>' +
        '<div class="oc-row3">' + esc(o.merchant) + ' · ' + esc(o.summary) + '</div>' +
        '<div class="oc-row4">' +
          '<span class="amt">' + fmtMoney(o.money.total) + '<small>' + fmtPoints(o.money.total) + '</small></span>' +
          '<span class="tm">' + esc(orderTimeStr(o)) + '</span>' +
        '</div>' +
        '<div class="oc-ops">' +
          '<button class="btn-ghost" data-act="detail">详情</button>' +
          (comp ? '<button class="btn-comp" data-act="comp">补偿积分</button>' : '') +
          '<button class="btn-push btn-primary" data-act="push">推送订单</button>' +
        '</div>' +
      '</div>';
    });
  }
  $('orderList').innerHTML = html;

  var btn = $('loadMore');
  if(show.length < data.length){
    btn.hidden = false;
    btn.innerHTML = '加载更多（还有 <b>' + (data.length - show.length) + '</b> 笔）';
  }else{
    btn.hidden = true;
  }
}

/* ---------- 卡片事件（事件委托） ---------- */
$('orderList').addEventListener('click', function(e){
  var card = e.target.closest('.order-card');
  if(!card) return;
  var id = card.getAttribute('data-id');
  var actBtn = e.target.closest('button[data-act]');
  if(actBtn){
    e.stopPropagation();
    var act = actBtn.getAttribute('data-act');
    if(act === 'detail') openDetail(id);
    else if(act === 'comp') openCompSheet(id);
    else if(act === 'push') doPush(actBtn);
    return;
  }
  openDetail(id);
});

$('loadMore').addEventListener('click', function(){
  state.page++;
  renderList();
});

/* 筛选事件 */
$('q').addEventListener('input', function(){ state.q = this.value; state.page = 1; renderList(); });
$('fStatus').addEventListener('change', function(){ state.status = this.value; state.page = 1; renderList(); });
$('fSource').addEventListener('change', function(){ state.source = this.value; state.page = 1; renderList(); });
$('fDateFrom').addEventListener('change', function(){ state.dateFrom = this.value; state.page = 1; renderList(); });
$('fDateTo').addEventListener('change', function(){ state.dateTo = this.value; state.page = 1; renderList(); });
$('fReset').addEventListener('click', function(){
  state.q = ''; state.status = ''; state.source = ''; state.dateFrom = ''; state.dateTo = ''; state.page = 1;
  $('q').value = ''; $('fStatus').value = ''; $('fSource').value = '';
  $('fDateFrom').value = ''; $('fDateTo').value = '';
  renderList();
});

/* ---------- 推送订单 ---------- */
function doPush(btn){
  if(btn._busy) return;
  btn._busy = true;
  var old = btn.innerHTML;
  btn.classList.add('busy');
  btn.textContent = '推送中…';
  setTimeout(function(){
    btn.classList.remove('busy');
    btn.classList.add('done');
    btn.textContent = '✓ 已推送';
    toast('订单已重新推送硬件，并同步至客服系统对话', true);
    setTimeout(function(){
      btn.classList.remove('done');
      btn.innerHTML = old;
      btn._busy = false;
    }, 900);
  }, 1200);
}

/* ---------- 补偿积分 ---------- */
function openCompSheet(orderId){
  var o = ORDERS[orderId];
  if(!o) return;
  state.compOrderId = orderId;
  var comped = sumComp(o);
  var limit = Math.max(0, Number(o.money.total) - comped);

  $('sheet').innerHTML =
    '<div class="sheet-grip"></div>' +
    '<div class="sheet-t">补偿积分申请</div>' +
    '<div class="mini-card">' +
      '订单 <b class="mono">' + esc(o.id) + '</b><br>' +
      esc(o.merchant) + ' · ' + esc(o.name) + '<br>' +
      '订单金额 <b>' + fmtPoints(o.money.total) + '</b>（' + fmtMoney(o.money.total) + '）<br>' +
      '已补偿 <b style="color:#FF6B35">' + fmtPoints(comped) + '</b>' +
    '</div>' +
    '<label>补偿积分数</label>' +
    '<input type="number" id="compPoints" inputmode="decimal" min="0.1" step="0.1" placeholder="请输入积分数">' +
    '<div class="limit-hint">可补偿上限 <b>' + fmtPoints(limit) + '</b>（累计补偿不可超过订单金额）</div>' +
    '<div class="err" id="compPointsErr"></div>' +
    '<label>申请原因（必填）</label>' +
    '<textarea id="compReason" placeholder="请描述补偿原因，如：配送超时 / 餐品洒漏 / 少送漏送…"></textarea>' +
    '<div class="err" id="compReasonErr"></div>' +
    '<button class="submit" id="compSubmit">提交申请</button>' +
    '<button class="cancel" id="compCancel">取消</button>';

  showSheet();

  $('compSubmit').onclick = function(){ submitComp(limit); };
  $('compCancel').onclick = hideSheet;
  $('compPoints').focus();
}

function submitComp(limit){
  var ptsEl = $('compPoints'), rsEl = $('compReason');
  var pts = parseFloat(ptsEl.value);
  var reason = rsEl.value.trim();
  var pErr = $('compPointsErr'), rErr = $('compReasonErr');
  pErr.className = 'err'; rErr.className = 'err';
  var ok = true;

  if(!(pts > 0)){
    pErr.textContent = '请输入大于 0 的积分数'; pErr.className = 'err show'; ok = false;
  }else if(pts > limit + 1e-9){
    pErr.textContent = '超出可补偿上限 ' + fmtPoints(limit);
    pErr.className = 'err show'; ok = false;
  }
  if(!reason){
    rErr.textContent = '请填写申请原因'; rErr.className = 'err show'; ok = false;
  }
  if(!ok) return;

  var o = ORDERS[state.compOrderId];
  var tm = nowStr();

  /* 1. 追加到订单补偿流水 */
  o.compensations = o.compensations || [];
  o.compensations.unshift({tm: tm, points: Number(pts.toFixed(1)), operator: CURRENT_CS});

  /* 2. 生成补偿审核单（待审核） */
  var seq = COMP_REVIEWS.length + 1;
  var cid = 'CP' + tm.slice(0,10).replace(/-/g,'') + String(seq).padStart(3,'0');
  COMP_REVIEWS.unshift({
    id: cid, orderId: o.id, points: Number(pts.toFixed(1)), reason: reason,
    applicant: '当前客服', applicantAccount: '13800138018', applyTm: tm,
    status: '待审核', reviewer: '', reviewerAccount: '', reviewTm: '', comment: ''
  });

  hideSheet();
  toast('补偿申请已提交，待审核通过后到账', true);
  if(state.detailId === o.id) renderDetail(o.id);
  renderList();
}

/* ---------- 弹层控制 ---------- */
function showSheet(){
  $('sheetMask').classList.add('show');
  $('sheet').classList.add('show');
}
function hideSheet(){
  $('sheetMask').classList.remove('show');
  $('sheet').classList.remove('show');
  state.compOrderId = null;
}
$('sheetMask').addEventListener('click', hideSheet);

/* ---------- 详情 ---------- */
function openDetail(id){
  state.detailId = id;
  renderDetail(id);
  $('viewList').hidden = true;
  $('viewDetail').hidden = false;
  $('detailBar').hidden = false;
  window.scrollTo(0, 0);
}
$('btnBack').addEventListener('click', function(){
  state.detailId = null;
  $('viewDetail').hidden = true;
  $('detailBar').hidden = true;
  $('viewList').hidden = false;
  renderList();
});

function kv(k, v){
  return '<div class="kv"><span class="k">' + k + '</span><span class="v">' + v + '</span></div>';
}

function renderDetail(id){
  var o = ORDERS[id];
  if(!o) return;
  var m = o.money;
  var h = '';

  /* 状态卡片 */
  h += '<div class="card status-card">' +
    badge(o.status, true) +
    '<span class="oid mono">' + esc(o.id) + '</span>' +
    '<span class="meta-line">来源：' + esc(o.source) + ' · 下单 ' + esc(orderTimeStr(o)) + '</span>' +
  '</div>';

  /* 配送中提示条 */
  if(o.status === '配送中' && o.eta){
    h += '<div class="eta-bar">' +
      '<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.8V8l2.2 1.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>' +
      '骑手配送中，预计 <b>' + esc(o.eta) + '</b> 送达，请老外留意房间电话</div>';
  }

  /* 闪购链接 */
  if(o.sgUrl){
    h += '<a class="sg-link" href="' + esc(o.sgUrl) + '" target="_blank" rel="noopener">' +
      '<span>闪购订单链接（企业账户）</span>' +
      '<svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 3h6v6M11 3L4.5 9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>' +
    '</a><div style="height:12px"></div>';
  }

  /* 用户信息 */
  h += '<div class="card"><div class="card-t">用户信息</div>' +
    kv('姓名', esc(o.name)) +
    kv('语言', esc(o.lang)) +
    kv('护照号', esc(maskPassport(o.passport))) +
    kv('手机号', esc(maskPhone(o.phone))) +
    kv('设备号', esc(o.deviceNo)) +
    kv('当前积分余额', esc(o.balance)) +
  '</div>';

  /* 客服代下单 */
  if(o.source === '客服代下单' && o.cs){
    h += '<div class="card"><div class="card-t">客服代下单信息</div>' +
      kv('客服姓名', esc(o.cs.name)) +
      kv('客服账号', esc(maskPhone(o.cs.account))) +
      kv('推送时间', esc(o.cs.push)) +
      kv('确认时间', esc(o.cs.confirm)) +
    '</div>';
  }

  /* 收货地址 */
  h += '<div class="card"><div class="card-t">收货地址</div>' +
    '<div class="addr-label">' + esc(o.addr.label) + '</div>' +
    '<div class="addr-detail">' + esc(o.addr.detail) + '</div>' +
    kv('联系方式', esc(o.addr.contact)) +
    '<div class="addr-note">备注：' + esc(o.addr.note) + '</div>' +
  '</div>';

  /* 商品明细 */
  h += '<div class="card"><div class="card-t">商品明细</div>' +
    '<table class="goods-table"><thead><tr>' +
      '<th>菜品</th><th>规格</th><th class="r">数量</th><th class="r">单价</th><th class="r">小计</th>' +
    '</tr></thead><tbody>';
  o.items.forEach(function(it){
    h += '<tr><td class="gname">' + esc(it.name) + '</td>' +
      '<td class="spec">' + esc(it.spec) + '</td>' +
      '<td class="r">×' + it.qty + '</td>' +
      '<td class="r">' + fmtMoney(it.price) + '</td>' +
      '<td class="r">' + fmtMoney(it.sub) + '</td></tr>';
  });
  h += '</tbody></table></div>';

  /* 金额与积分 */
  h += '<div class="card"><div class="card-t">金额与积分</div>' +
    '<div class="money-row"><span>商品小计</span><span class="v">' + fmtMoney(m.goods) + '</span></div>' +
    '<div class="money-row"><span>配送费</span><span class="v">' + fmtMoney(m.delivery) + '</span></div>' +
    '<div class="money-row"><span>平台服务费</span><span class="v">' + fmtMoney(m.service) + '</span></div>' +
    '<div class="money-row total"><span>应付总额</span><span class="v">' + fmtMoney(m.total) + '</span></div>' +
    '<div class="money-row"><span>扣减积分（含服务费）</span><span class="v">' + fmtPoints(m.total) + '</span></div>' +
    '<div class="money-row"><span>闪购企业账户实扣</span><span class="v">' + fmtMoney(m.goods) + '</span></div>' +
    '<div class="money-row"><span>平台毛利</span><span class="v">' + fmtMoney(m.service) + '</span></div>';
  if(o.status === '已取消' || o.status === '下单或履约失败'){
    h += '<div class="money-note thaw">未扣减（已解冻），无资损</div>';
  }
  if(o.status === '已退款' && o.refund){
    h += '<div class="money-note refund">已退回 +' + Number(o.refund.points).toFixed(1) +
      ' 积分（含服务费） · ' + esc(o.refund.status) + '</div>';
  }
  h += '</div>';

  /* 履约时间线 */
  h += '<div class="card"><div class="card-t">履约状态</div><div class="timeline">';
  o.timeline.forEach(function(t){
    h += '<div class="tl-item ' + esc(t.state) + '">' +
      '<span class="tl-dot"></span>' +
      '<div class="tl-t">' + esc(t.t) + '</div>' +
      '<div class="tl-d">' + esc(t.d || '待更新') + '</div>' +
    '</div>';
  });
  h += '</div></div>';

  /* 操作与对账日志 */
  h += '<div class="card"><div class="card-t">操作与对账日志</div>';
  o.logs.forEach(function(l){
    h += '<div class="log-item"><span class="log-tm">' + esc(l.tm) + '</span>' +
      '<span class="log-txt">' + esc(l.txt) + '</span>' +
      '<span class="log-op">' + esc(l.op) + '</span></div>';
  });
  h += '</div>';

  /* 补偿积分流水 */
  h += '<div class="card"><div class="card-t">补偿积分流水</div>';
  if(o.compensations && o.compensations.length){
    o.compensations.forEach(function(c){
      h += '<div class="comp-item"><span>' + esc(c.tm) + '<br><small style="color:#B0B3B8">' +
        esc(c.operator) + '</small></span><span class="p">+' + fmtPoints(c.points) + '</span></div>';
    });
  }else{
    h += '<div class="comp-empty">暂无补偿记录</div>';
  }
  h += '</div>';

  /* 退款明细 */
  if(o.status === '已退款' && o.refund){
    h += '<div class="card"><div class="card-t">退款明细</div>' +
      kv('退款状态', '<b style="color:#722ED1">' + esc(o.refund.status) + '</b>') +
      kv('退回积分', '+' + fmtPoints(o.refund.points)) +
      kv('退款完成时间', esc(o.refund.complete)) +
    '</div>';
  }

  $('detailBody').innerHTML = h;
  renderDetailBar(o);
}

/* 详情底部操作栏 */
function renderDetailBar(o){
  var bar = $('detailBar');
  var canRefresh = !!REFRESH_OK[o.status];
  var comp = canComp(o);
  var html =
    '<button class="btn-ghost btn-refresh" id="dRefresh" ' + (canRefresh ? '' : 'disabled') + '>' +
      (canRefresh ? '刷新状态' : '刷新状态（当前状态不可刷新）') + '</button>';
  if(comp){
    html += '<button class="btn-comp" id="dComp">补偿积分</button>';
  }
  html += '<button class="btn-push btn-primary" id="dPush">推送订单</button>';
  bar.innerHTML = html;

  if(canRefresh){
    $('dRefresh').addEventListener('click', function(){
      var btn = this;
      if(btn._busy) return;
      btn._busy = true;
      btn.classList.add('busy');
      var old = btn.textContent;
      btn.textContent = '刷新中…';
      setTimeout(function(){
        btn.classList.remove('busy');
        btn.textContent = old;
        btn._busy = false;
        toast('订单状态已刷新', true);
      }, 1200);
    });
  }
  if(comp){
    $('dComp').addEventListener('click', function(){ openCompSheet(o.id); });
  }
  $('dPush').addEventListener('click', function(){ doPush(this); });
}

/* ---------- 初始化 ---------- */
renderList();
</script>
