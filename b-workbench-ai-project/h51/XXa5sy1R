<script src="h5-shared-data.js"></script>
<script>
/* ============================================================
 * 打车代下单 · 客服端 H5
 * 流程：① 老外档案 → ② 搜索上车点 → ③ 目的地+预估价格+推送
 * ============================================================ */

// ---------- 全局状态 ----------
let TOURIST = null;            // 当前老外
let touristIdx = 0;            // 当前老外索引
let curStep = 1;               // 当前步骤 1/2/3
let selectedPu = null;         // 已选上车点 {zh,en,lng,lat,dist}
let selectedDst = null;        // 已选目的地 {zh,en,lng,lat,dist}
let estimate = null;           // 预估结果 {km, minutes, cars:[{car,seats,flag,route,cao,svc,total,ok}]}
let selectedCars = {};         // 勾选的车档 {car: true}
let estimateExpireAt = 0;      // 预估价格过期时间戳
let estimateTimerId = null;    // 倒计时定时器
let orderPushed = false;       // 是否已推送
let orderCardId = null;        // 当前推送卡片 ID
let cardSeq = 0;               // 硬件卡片序号
let confirmMode = false;       // 是否老外已确认

// ---------- 工具 ----------
function $(id){ return document.getElementById(id); }
function show(id){ $(id).classList.remove('hidden'); }
function hide(id){ $(id).classList.add('hidden'); }
function esc(s){ return escHtml(s); }
function money(n){ return fmtMoney(n); }

let toastTimer = null;
function toast(msg, ms){
  ms = ms || 2400;
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){ t.classList.remove('show'); }, ms);
}

// 简单的经纬度直线距离（km）
function calcDist(lng1, lat1, lng2, lat2){
  const R = 6371;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLng = (lng2 - lng1) * Math.PI / 180;
  const a = Math.sin(dLat/2)*Math.sin(dLat/2) +
            Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*
            Math.sin(dLng/2)*Math.sin(dLng/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
}

function fmtDist(km){
  if(km < 1) return Math.round(km * 1000) + 'm';
  return km.toFixed(1) + 'km';
}

// 从 TX_PLACES 中找到最近的 n 个点位
function findNearest(lng, lat, n){
  return Object.keys(TX_PLACES).map(function(key){
    const p = TX_PLACES[key];
    return { key: key, zh: p[0], en: p[1], lng: p[2], lat: p[3],
             dist: calcDist(lng, lat, p[2], p[3]) };
  }).sort(function(a, b){ return a.dist - b.dist; }).slice(0, n || 5);
}

// 关键词搜索 TX_PLACES（中文或英文）
function searchPlaces(keyword){
  const kw = keyword.toLowerCase().trim();
  if(!kw) return [];
  return Object.keys(TX_PLACES).map(function(key){
    const p = TX_PLACES[key];
    return { key: key, zh: p[0], en: p[1], lng: p[2], lat: p[3] };
  }).filter(function(item){
    return item.zh.toLowerCase().indexOf(kw) >= 0 ||
           item.en.toLowerCase().indexOf(kw) >= 0;
  });
}

// ---------- 步骤条 ----------
function renderStepbar(){
  document.querySelectorAll('.step-item').forEach(function(item){
    const s = parseInt(item.dataset.step);
    item.classList.remove('active', 'done');
    if(s < curStep) item.classList.add('done');
    else if(s === curStep) item.classList.add('active');
  });
}

function goStep(n){
  curStep = n;
  ['step1','step2','step3'].forEach(function(id, i){ $(id).classList.add('hidden'); });
  $('step' + n).classList.remove('hidden');
  renderStepbar();

  if(n === 1){
    hide('nextBar'); hide('pushBar');
    $('pageBody').classList.remove('has-action');
  } else if(n === 2){
    show('nextBar'); hide('pushBar');
    $('pageBody').classList.remove('has-action');
  } else if(n === 3){
    hide('nextBar'); show('pushBar');
    $('pageBody').classList.add('has-action');
  }
  window.scrollTo(0, 0);
}

// ---------- 老外渲染 ----------
function renderTourist(){
  const t = TOURIST;
  $('tName').textContent = t.name;
  $('tSub').textContent = t.lang + ' · ' + t.city;
  $('tUserId').textContent = userIdOf(t);
  $('tLang').textContent = t.lang;
  $('tPassport').textContent = t.passport;
  $('tPhone').textContent = maskPhone(t.phone);
  $('tDevice').textContent = t.deviceNo;
  $('tLngLat').textContent = t.lng.toFixed(4) + ', ' + t.lat.toFixed(4);
  $('tCity').textContent = t.city;
  const bal = Number(t.balance).toFixed(1);
  $('tBalance').innerHTML = bal + '<small> 积分</small>';
  $('tBalance2').innerHTML = bal + '<small> 积分</small>';
  $('tBalance3').innerHTML = bal + '<small> 积分</small>';
  $('hwDevice2').textContent = t.deviceNo;
  $('hwDevice3').textContent = t.deviceNo;
}

// ---------- 第②步：上车点搜索 ----------
function bindPuSearch(){
  $('puSearchBtn').addEventListener('click', doPuSearch);
  $('nextStepBtn').addEventListener('click', function(){
    if(!selectedPu){ toast('请先选择上车点'); return; }
    goStep(3);
    renderStep3Header();
  });
}

function doPuSearch(){
  const lngLatVal = $('puLngLat').value.trim();
  const kwVal = $('puKeyword').value.trim();

  // 优先使用关键词
  if(kwVal){
    const results = searchPlaces(kwVal);
    if(!results.length){
      toast('未找到匹配的地点');
      hide('puMapBox'); hide('puResultWrap');
      selectedPu = null;
      hide('nextBar');
      return;
    }
    // 给每个结果加上距离（基于老外当前定位）
    results.forEach(function(r){
      r.dist = calcDist(TOURIST.lng, TOURIST.lat, r.lng, r.lat);
    });
    results.sort(function(a, b){ return a.dist - b.dist; });
    renderPoiResults(results, 'keyword');
    return;
  }

  // 否则使用经纬度
  if(lngLatVal){
    const m = lngLatVal.match(/^\s*([0-9.]+)\s*[,，\s]\s*([0-9.]+)\s*$/);
    if(!m){
      toast('经纬度格式不正确，如：120.1612,30.2490');
      return;
    }
    const lng = parseFloat(m[1]);
    const lat = parseFloat(m[2]);
    if(isNaN(lng) || isNaN(lat) || lng < 70 || lng > 140 || lat < 3 || lat > 55){
      toast('经纬度超出中国范围，请检查');
      return;
    }
    // 找最近 5 个点位
    const near = findNearest(lng, lat, 5);
    renderMap(lng, lat, near);
    renderPoiResults(near, 'nearby');
    return;
  }

  toast('请输入经纬度或关键词');
}

function renderMap(lng, lat, list){
  show('puMapBox');
  $('mapDotPuLbl').textContent = '老外位置';
  // 在地图上随机布置点位标记
  const wrap = $('puMapBox');
  // 清除旧的蓝色标记
  wrap.querySelectorAll('.map-dot.dst').forEach(function(el){ el.remove(); });
  list.forEach(function(p, i){
    const dot = document.createElement('div');
    dot.className = 'map-dot dst';
    const x = 30 + (i * 15) % 55;
    const y = 20 + (i * 22) % 50;
    dot.style.left = x + '%';
    dot.style.top = y + '%';
    wrap.appendChild(dot);
  });
}

function renderPoiResults(list, mode){
  show('puResultWrap');
  const title = mode === 'nearby' ? '周边推荐上车点' : '搜索结果（点击选择后查看周边上车点）';
  $('puResultTitle').textContent = title;
  const wrap = $('puResultList');
  wrap.innerHTML = '';
  list.forEach(function(p, i){
    const item = document.createElement('div');
    item.className = 'poi-item';
    if(mode === 'nearby' && i === 0) item.classList.add('selected');
    const distTxt = fmtDist(p.dist);
    item.innerHTML =
      '<div class="poi-zh">' + esc(p.zh) + '</div>' +
      '<div class="poi-en">' + esc(p.en) + '</div>' +
      '<div class="poi-dist">📍 距离 ' + distTxt + '</div>';
    item.addEventListener('click', function(){
      if(mode === 'keyword'){
        // 关键词模式：选中 POI 后，展示该 POI 周边上车点
        selectPoiAsPu(p);
      } else {
        // 周边模式：直接选中
        wrap.querySelectorAll('.poi-item').forEach(function(el){ el.classList.remove('selected'); });
        item.classList.add('selected');
        selectedPu = p;
        show('nextBar');
      }
    });
    wrap.appendChild(item);
  });

  // 默认选中第一个（周边模式）
  if(mode === 'nearby' && list.length){
    selectedPu = list[0];
    show('nextBar');
  } else if(mode === 'keyword'){
    selectedPu = null;
    hide('nextBar');
  }
}

function selectPoiAsPu(p){
  // 选中关键词搜索结果作为上车点
  const near = findNearest(p.lng, p.lat, 5);
  near.forEach(function(n){ n.dist = calcDist(p.lng, p.lat, n.lng, n.lat); });
  selectedPu = p;
  show('nextBar');
  renderMap(p.lng, p.lat, near);
  // 显示周边推荐列表
  show('puResultWrap');
  $('puResultTitle').textContent = '「' + p.zh + '」周边推荐上车点';
  const wrap = $('puResultList');
  wrap.innerHTML = '';
  near.forEach(function(n, i){
    const item = document.createElement('div');
    item.className = 'poi-item';
    if(i === 0) item.classList.add('selected');
    item.innerHTML =
      '<div class="poi-zh">' + esc(n.zh) + '</div>' +
      '<div class="poi-en">' + esc(n.en) + '</div>' +
      '<div class="poi-dist">📍 距离 ' + fmtDist(n.dist) + '</div>';
    item.addEventListener('click', function(){
      wrap.querySelectorAll('.poi-item').forEach(function(el){ el.classList.remove('selected'); });
      item.classList.add('selected');
      selectedPu = n;
      show('nextBar');
    });
    wrap.appendChild(item);
  });
}

// ---------- 第③步：目的地 + 预估 ----------
function renderStep3Header(){
  if(selectedPu){
    $('puSelectedTxt').textContent = selectedPu.zh + '（' + selectedPu.en + '）';
  }
}

function bindDstSearch(){
  $('dstKeyword').addEventListener('input', function(){
    const kw = this.value.trim();
    if(!kw){ hide('dstResultWrap'); return; }
    const results = searchPlaces(kw);
    if(!results.length){
      $('dstResultWrap').innerHTML = '';
      show('dstResultWrap');
      $('dstResultWrap').innerHTML = '<div class="poi-empty">未找到匹配的目的地</div>';
      return;
    }
    results.forEach(function(r){
      r.dist = calcDist(selectedPu.lng, selectedPu.lat, r.lng, r.lat);
    });
    results.sort(function(a, b){ return a.dist - b.dist; });
    show('dstResultWrap');
    const wrap = $('dstResultList');
    wrap.innerHTML = '';
    results.forEach(function(r){
      const item = document.createElement('div');
      item.className = 'poi-item';
      item.innerHTML =
        '<div class="poi-zh">' + esc(r.zh) + '</div>' +
        '<div class="poi-en">' + esc(r.en) + '</div>' +
        '<div class="poi-dist">📍 距上车点 ' + fmtDist(r.dist) + '</div>';
      item.addEventListener('click', function(){
        selectedDst = r;
        wrap.querySelectorAll('.poi-item').forEach(function(el){ el.classList.remove('selected'); });
        item.classList.add('selected');
        // 显示预估价格按钮
        showEstimateBtn();
      });
      wrap.appendChild(item);
    });
  });

  $('changePuBtn').addEventListener('click', function(){
    resetStep3();
    goStep(2);
  });
}

function showEstimateBtn(){
  // 显示预估价格卡片（触发计算）
  calcEstimate();
}

function calcEstimate(){
  if(!selectedPu || !selectedDst) return;
  const straightKm = calcDist(selectedPu.lng, selectedPu.lat, selectedDst.lng, selectedDst.lat);
  const km = Number((straightKm * 1.2).toFixed(1));
  const minutes = Math.round(km * 2 + 6);
  const balance = Number(TOURIST.balance);

  const cars = TX_DEFAULT_CARS.map(function(car){
    const flag = TX_CAR_FLAGFALL[car];
    const rate = TX_CAR_RATE[car];
    const cao = Number((flag + rate * km).toFixed(1));
    const svc = Number((cao * 0.1).toFixed(1));
    const total = Number((cao + svc).toFixed(1));
    const seats = TX_CAR_SEATS[car] || '';
    const ok = total <= balance;
    return { car: car, seats: seats, cao: cao, svc: svc, total: total, ok: ok };
  });

  estimate = { km: km, minutes: minutes, cars: cars };

  // 默认勾选积分足够的车档
  selectedCars = {};
  cars.forEach(function(c){ if(c.ok) selectedCars[c.car] = true; });

  // 显示卡片
  show('estimateCard');
  $('tripSummary').innerHTML =
    '<b>' + esc(selectedPu.zh) + '</b> → <b>' + esc(selectedDst.zh) + '</b><br>' +
    '预估里程 ' + km + ' km · 约 ' + minutes + ' 分钟';

  renderCarOptions();

  // 启动倒计时：9分50秒
  estimateExpireAt = Date.now() + (9 * 60 + 50) * 1000;
  startEstimateTimer();

  updatePushBtn();
}

function renderCarOptions(){
  const wrap = $('carOptions');
  wrap.innerHTML = '';
  estimate.cars.forEach(function(c){
    const checked = selectedCars[c.car];
    const div = document.createElement('div');
    div.className = 'car-option' + (checked ? ' selected' : '') + (c.ok ? '' : ' disabled');
    div.dataset.car = c.car;
    div.innerHTML =
      '<div class="car-check">' +
        '<svg viewBox="0 0 24 24" fill="white"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>' +
      '</div>' +
      '<div class="car-info">' +
        '<div class="car-name">' + esc(c.car) + '<small>' + esc(c.seats) + '</small></div>' +
        '<div class="car-price">曹操价 <b>' + money(c.cao) + '</b> + 服务费 <b>' + money(c.svc) + '</b></div>' +
      '</div>' +
      '<div class="car-total">' + money(c.total) + '<small>预估总价</small></div>' +
      (!c.ok ? '<div class="car-short">积分不足</div>' : (checked ? '<div class="car-tag">已勾选</div>' : ''));
    div.addEventListener('click', function(){
      if(!c.ok){ toast('积分不足，无法选择该车档'); return; }
      if(selectedCars[c.car]) delete selectedCars[c.car];
      else selectedCars[c.car] = true;
      renderCarOptions();
      updatePushBtn();
    });
    wrap.appendChild(div);
  });
}

function startEstimateTimer(){
  clearInterval(estimateTimerId);
  function tick(){
    const remain = Math.max(0, estimateExpireAt - Date.now());
    if(remain <= 0){
      clearInterval(estimateTimerId);
      $('estimateTimer').textContent = '预估价格已过期，请重新点击「预估价格」';
      estimate = null;
      selectedCars = {};
      updatePushBtn();
      return;
    }
    const totalSec = Math.floor(remain / 1000);
    const min = Math.floor(totalSec / 60);
    const sec = totalSec % 60;
    const expire = new Date(estimateExpireAt);
    const hh = ('0' + expire.getHours()).slice(-2);
    const mm = ('0' + expire.getMinutes()).slice(-2);
    $('estimateTimer').textContent = '预估价格有效期至 ' + hh + ':' + mm + '（' + min + ' 分 ' + sec + ' 秒）';
  }
  tick();
  estimateTimerId = setInterval(tick, 1000);
}

function getSelectedCarCount(){
  return Object.keys(selectedCars).length;
}

function updatePushBtn(){
  const btn = $('pushBtn');
  const n = getSelectedCarCount();
  if(estimate && n > 0 && !orderPushed){
    btn.disabled = false;
    $('pushBtnTxt').textContent = '推送打车订单给老外确认（已选 ' + n + ' 个车档）';
  } else {
    btn.disabled = true;
    $('pushBtnTxt').textContent = orderPushed ? '已推送，等待老外确认…' : '推送打车订单给老外确认';
  }
}

// ---------- 推送 ----------
function bindPush(){
  $('pushBtn').addEventListener('click', function(){
    if(orderPushed) return;
    const n = getSelectedCarCount();
    if(n === 0){ toast('请至少勾选一个车档'); return; }
    if(!estimate){ toast('请先预估价格'); return; }

    const btn = this;
    btn.classList.add('busy');
    btn.disabled = true;

    setTimeout(function(){
      btn.classList.remove('busy');
      orderPushed = true;
      toast('已推送打车订单（' + n + ' 个车档），等待老外确认');
      addHwCard();
      updatePushBtn();
    }, 1200);
  });
}

function addHwCard(){
  cardSeq++;
  orderCardId = 'tx_card_' + cardSeq;
  const t = TOURIST;
  const selectedCarList = estimate.cars.filter(function(c){ return selectedCars[c.car]; });
  const svcSum = selectedCarList.reduce(function(s, c){ return s + c.svc; }, 0);
  const totalSum = selectedCarList.reduce(function(s, c){ return s + c.total; }, 0);

  const cardHtml =
    '<div class="hw-card" id="' + orderCardId + '">' +
      '<div class="hw-card-head">' +
        '<span class="hw-card-type taxi">打车订单</span>' +
        '<span class="hw-card-status" id="' + orderCardId + '_status">待确认</span>' +
      '</div>' +
      '<div class="hw-card-body">' +
        '<div class="row"><span class="rk">老外</span><span class="rv">' + esc(t.name) + '（' + esc(t.lang) + '）</span></div>' +
        '<div class="row"><span class="rk">上车点</span><span class="rv">' + esc(selectedPu.zh) + '</span></div>' +
        '<div class="row"><span class="rk">目的地</span><span class="rv">' + esc(selectedDst.zh) + '</span></div>' +
        '<div class="row"><span class="rk">行程</span><span class="rv">约 ' + estimate.km + ' km · ' + estimate.minutes + ' 分钟</span></div>' +
        selectedCarList.map(function(c){
          return '<div class="row"><span class="rk">' + esc(c.car) + '</span><span class="rv">' + money(c.total) + '（曹操 ' + money(c.cao) + ' + 服务费 ' + money(c.svc) + '）</span></div>';
        }).join('') +
        '<div class="money-line">服务费合计 ' + money(svcSum) + ' · 最高预估 ' + money(totalSum) + '</div>' +
      '</div>' +
      '<div class="hw-card-ops">' +
        '<button class="hw-btn-ok" onclick="hwConfirm(\'' + orderCardId + '\')">确认</button>' +
        '<button class="hw-btn-no" onclick="hwReject(\'' + orderCardId + '\')">拒绝</button>' +
      '</div>' +
    '</div>';

  show('hwPanel3');
  const body = $('hwCards3');
  // 移除空状态
  const empty = body.querySelector('.hw-empty');
  if(empty) empty.remove();
  body.insertAdjacentHTML('afterbegin', cardHtml);
}

function hwConfirm(cardId){
  if(confirmMode) return;
  confirmMode = true;
  const card = $(cardId);
  card.querySelector('.hw-card-ops').style.display = 'none';
  const st = $(cardId + '_status');
  st.textContent = '已确认';
  st.classList.add('confirmed');

  // 构建订单摘要
  const selectedCarList = estimate.cars.filter(function(c){ return selectedCars[c.car]; });
  const svcSum = selectedCarList.reduce(function(s, c){ return s + c.svc; }, 0);
  const totalSum = selectedCarList.reduce(function(s, c){ return s + c.total; }, 0);

  const summaryHtml =
    '<div class="row"><span class="rk">老外</span><span class="rv">' + esc(TOURIST.name) + '（' + esc(TOURIST.lang) + '）</span></div>' +
    '<div class="row"><span class="rk">上车点</span><span class="rv">' + esc(selectedPu.zh) + '（' + esc(selectedPu.en) + '）</span></div>' +
    '<div class="row"><span class="rk">目的地</span><span class="rv">' + esc(selectedDst.zh) + '（' + esc(selectedDst.en) + '）</span></div>' +
    '<div class="row"><span class="rk">行程</span><span class="rv">约 ' + estimate.km + ' km · ' + estimate.minutes + ' 分钟</span></div>' +
    selectedCarList.map(function(c){
      return '<div class="row"><span class="rk">' + esc(c.car) + '</span><span class="rv">' + money(c.total) + '</span></div>';
    }).join('') +
    '<div class="row"><span class="rk">服务费</span><span class="rv money">合计 ' + money(svcSum) + '</span></div>' +
    '<div class="row"><span class="rk">最高预估</span><span class="rv money">' + money(totalSum) + '</span></div>';

  $('forceSummary').innerHTML = summaryHtml;
  $('forceMask').classList.add('show');
}

function hwReject(cardId){
  if(confirmMode) return;
  const card = $(cardId);
  card.querySelector('.hw-card-ops').style.display = 'none';
  const st = $(cardId + '_status');
  st.textContent = '已拒绝';
  st.classList.add('rejected');
  orderPushed = false;
  orderCardId = null;
  updatePushBtn();
  toast('老外已拒绝，客服可重新推送（或重新预估价格）');
}

function bindForceClose(){
  $('forceCloseBtn').addEventListener('click', function(){
    $('forceMask').classList.remove('show');
    // 重置流程，自动选下一位老外
    resetAll();
    touristIdx = (touristIdx + 1) % TX_TOURISTS.length;
    TOURIST = TX_TOURISTS[touristIdx];
    renderTourist();
    goStep(2);
    // 自动填入新老外定位
    $('puLngLat').value = TOURIST.lng.toFixed(4) + ',' + TOURIST.lat.toFixed(4);
    $('puKeyword').value = '';
    toast('已切换至下一位老外：' + TOURIST.name);
  });
}

function resetStep3(){
  selectedDst = null;
  estimate = null;
  selectedCars = {};
  orderPushed = false;
  orderCardId = null;
  confirmMode = false;
  clearInterval(estimateTimerId);
  $('dstKeyword').value = '';
  hide('dstResultWrap');
  hide('estimateCard');
  hide('hwPanel3');
  $('hwCards3').innerHTML = '';
}

function resetAll(){
  resetStep3();
  selectedPu = null;
  hide('puMapBox');
  hide('puResultWrap');
  hide('nextBar');
  $('puLngLat').value = '';
  $('puKeyword').value = '';
}

// ---------- 初始化 ----------
function init(){
  TOURIST = TX_TOURISTS[touristIdx];
  renderTourist();
  bindPuSearch();
  bindDstSearch();
  bindPush();
  bindForceClose();

  // 默认回显老外当前定位
  $('puLngLat').value = TOURIST.lng.toFixed(4) + ',' + TOURIST.lat.toFixed(4);

  // 老外硬件端空状态
  $('hwCards2').innerHTML = '<div class="hw-empty">暂无推送卡片</div>';
  $('hwCards3').innerHTML = '<div class="hw-empty">暂无推送卡片</div>';

  // 初始进入第②步（第①步已自动获取）
  goStep(2);
}

init();
</script>
</body>
</html>
