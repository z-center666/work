      '乘客 ' + esc(o.name) + '（' + esc(maskPassport(o.passport)) + '）' +
    '</div>';

  if(hasFee){
    h += '<div class="fee-tip warn">' +
      '⚠️ 将扣除老外积分 <b>' + fmtPoints(o.tCancelFee) + '</b><br>' +
      '<span style="font-size:.7rem;opacity:.85">曹操侧已开启计费 / 超过免费取消时长</span></div>';
  }else{
    h += '<div class="fee-tip ok">✅ 当前处于免费取消时长内，取消后冻结积分 <b>' +
      fmtPoints(o.tFrozen) + '</b> 将全额解冻</div>';
  }

  h += '<label>取消原因（必填）</label>' +
    '<textarea id="cancelReason" placeholder="请填写取消原因，如：老外行程有变 / 重复下单 / 改用其他交通…"></textarea>' +
    '<div class="err" id="cancelReasonErr"></div>' +
    '<button class="submit' + (hasFee ? ' danger' : '') + '" id="cancelSubmit">' +
      (hasFee ? '发起取消并推送给老外确认（将扣 ' + fmtPoints(o.tCancelFee) + '）' : '确认取消订单') +
    '</button>' +
    '<button class="cancel" id="cancelClose">关闭</button>';

  $('sheet').innerHTML = h;
  showSheet();

  $('cancelClose').onclick = hideSheet;
  $('cancelSubmit').onclick = function(){ submitCancel(hasFee); };
  $('cancelReason').focus();
}

function submitCancel(hasFee){
  var rsEl = $('cancelReason');
  var reason = rsEl.value.trim();
  var err = $('cancelReasonErr');
  err.className = 'err';
  if(!reason){
    err.textContent = '请填写取消原因';
    err.className = 'err show';
    return;
  }
  var o = getOrder(state.sheetOrderId);
  if(!o) { hideSheet(); return; }

  if(!hasFee){
    /* 直接取消 */
    o.tCaoStatus = 20;
    o.status = '用户取消';
    o.tCancelReason = reason;
    o.tCancelPending = false;
    o.tCancelMsg = null;
    txBuildStreams(o);
    o.tLogs.push({tm: nowStr(), operator:'客服', action:'客服取消订单（免费取消）：' + reason});
    hideSheet();
    toast('已取消：冻结积分全额解冻', true);
  }else{
    /* 推送老外确认 */
    o.tCancelPending = true;
    o.tCancelMsg = {reason: reason, fee: o.tCancelFee, tm: nowStr()};
    o.tLogs.push({tm: nowStr(), operator:'客服', action:'发起取消并推送老外确认（将扣取消费 ' + fmtPoints(o.tCancelFee) + '）：' + reason});
    hideSheet();
    toast('已推送老外确认取消（将扣 ' + fmtPoints(o.tCancelFee) + '），等待老外端确认', true);
  }
  renderList();
  if(state.detailId === o.id) renderDetail(o.id);
}

