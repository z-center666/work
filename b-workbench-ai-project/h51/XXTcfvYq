/* ---------- 推送订单 ---------- */
function doPush(btn){
  if(btn._busy) return;
  btn._busy = true;
  var old = btn.innerHTML;
  btn.classList.add('busy');
  btn.textContent = '推送中…';
  setTimeout(function(){
    btn.classList.remove('busy');
    btn.classList.add('done');
    btn.textContent = '✓ 已推送';
    toast('打车订单已重新推送硬件，并同步至客服系统对话', true);
    setTimeout(function(){
      btn.classList.remove('done');
      btn.innerHTML = old;
      btn._busy = false;
    }, 900);
  }, 1200);
}

