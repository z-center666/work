/* ---------- 列表数据 ---------- */
function allOrders(){
  return Object.keys(TAXI_ORDERS).map(function(k){ return TAXI_ORDERS[k]; })
    .sort(function(a,b){ return (b.tCreated || '').localeCompare(a.tCreated || ''); });
}
function filtered(){
  var q = state.q.trim().toLowerCase();
  return allOrders().filter(function(o){
    if(q){
      var hay = [o.tCaoNo, o.name, o.passport, o.deviceNo].join(' ').toLowerCase();
      if(hay.indexOf(q) < 0) return false;
    }
    if(state.status && String(o.tCaoStatus) !== state.status) return false;
    var d = orderDate(o);
    if(state.dateFrom && d && d < state.dateFrom) return false;
    if(state.dateTo && d && d > state.dateTo) return false;
    return true;
  });
}

