function renderDestResults(kw){
  var o = getOrder(state.sheetOrderId);
  if(!o) return;
  kw = (kw || '').trim().toLowerCase();
  var list = [];
  Object.keys(TX_PLACES).forEach(function(k){
    var p = TX_PLACES[k];
    var hit = !kw ||
      p[0].toLowerCase().indexOf(kw) >= 0 ||
      p[1].toLowerCase().indexOf(kw) >= 0 ||
      k.toLowerCase().indexOf(kw) >= 0;
    if(hit) list.push({key:k, zh:p[0], en:p[1], lng:p[2], lat:p[3],
      dist: distKm(o.tPickup, {lng:p[2], lat:p[3]})});
  });
  list.sort(function(a,b){ return a.dist - b.dist; });
  list = list.slice(0, 12);

  var h = '<div class="place-list-title">搜索结果（点击选择）</div>';
  if(!list.length){
    h += '<div class="comp-empty">未找到匹配地点</div>';
  }else{
    list.forEach(function(p){
      h += '<div class="place-item" data-lng="' + p.lng + '" data-lat="' + p.lat + '" data-zh="' + esc(p.zh) + '" data-en="' + esc(p.en) + '">' +
        '<div class="pin"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="#0669FF" stroke-width="1.4"/><circle cx="7" cy="7" r="2" fill="#0669FF"/></svg></div>' +
        '<div class="p-info"><div class="p-zh">' + esc(p.zh) + '</div><div class="p-en">' + esc(p.en) + '</div></div>' +
        '<div class="p-dist">' + fmtKm(p.dist) + '</div>' +
      '</div>';
    });
  }
  $('destResults').innerHTML = h;
  Array.prototype.forEach.call($('destResults').querySelectorAll('.place-item'), function(el){
    el.onclick = function(){ onPickDest(el); };
  });
}

function onDestSearch(){
  renderDestResults(this.value);
}

function onPickDest(el){
  var o = getOrder(state.sheetOrderId);
  if(!o) return;
  var dest = {zh: el.getAttribute('data-zh'), en: el.getAttribute('data-en'),
    lng: +el.getAttribute('data-lng'), lat: +el.getAttribute('data-lat')};
  var est = estimateNew(o.tPickup, dest, o.tCarType);
  var oldTotal = +(o.tEst.cao + o.tEst.svc).toFixed(1);
  var delta = +(est.total - oldTotal).toFixed(1);
  state.destSel = {dest:dest, est:est, delta:delta};

  var deltaHtml;
  if(delta > 0){
    deltaHtml = '<span class="delta up">需追加冻结 ' + fmtPoints(delta) + '</span>';
  }else if(delta < 0){
    deltaHtml = '<span class="delta down">解冻差额 ' + fmtPoints(-delta) + '</span>';
  }else{
    deltaHtml = '<span style="color:#52C41A;font-weight:700">预估价格不变</span>';
  }

  $('destCmp').innerHTML = '' +
    '<div class="fee-cmp">' +
      '<div class="fee-cmp-t">预估价格对比（' + esc(o.tCarType) + '）</div>' +
      '<div class="fee-cmp-row"><span>新目的地</span><b>' + esc(dest.zh) + '</b></div>' +
      '<div class="fee-cmp-row"><span>行程距离 / 时长</span><span>' + fmtKm(est.km) + ' / 约' + est.minutes + '分钟</span></div>' +
      '<div class="fee-cmp-row"><span>曹操预估价</span><span>' + fmtMoney(est.cao) + '</span></div>' +
      '<div class="fee-cmp-row"><span>平台服务费</span><span>' + fmtMoney(est.svc) + '</span></div>' +
      '<div class="fee-cmp-row"><span>新预估总价</span><b style="color:#0669FF">' + fmtMoney(est.total) + '（' + fmtPoints(est.total) + '）</b></div>' +
      '<div class="fee-cmp-row"><span>原预估总价</span><span>' + fmtMoney(oldTotal) + '（' + fmtPoints(oldTotal) + '）</span></div>' +
      '<div class="fee-cmp-row"><span>差额</span>' + deltaHtml + '</div>' +
    '</div>';

  $('destPending').innerHTML = '';
  $('destSubmitWrap').style.display = '';
  $('destSubmit').onclick = submitDestChange;
}

function submitDestChange(){
  var o = getOrder(state.sheetOrderId);
  if(!o || !state.destSel) return;
  var sel = state.destSel;
  o.tDestPending = true;
  o.tDestProposal = {dest: sel.dest, est: sel.est, delta: sel.delta, tm: nowStr()};
  o.tDestMsg = {dest: sel.dest, est: sel.est, delta: sel.delta, tm: nowStr()};
  o.tLogs.push({tm: nowStr(), operator:'客服',
    action:'推送改目的地请求给老外确认：新目的地「' + sel.dest.zh + '」（预估 ' + fmtMoney(sel.est.total) + '）'});

  $('destSubmitWrap').style.display = 'none';
  $('destCmp').innerHTML = '';
  renderDestPending();
  toast('已推送老外确认改目的地（' + sel.dest.zh + '），等待老外确认', true);
  renderList();
  if(state.detailId === o.id) renderDetail(o.id);
}

