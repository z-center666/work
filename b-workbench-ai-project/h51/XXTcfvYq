/* 距离（km） */
function distKm(a, b){
  if(!a || !b || !a.lng || !a.lat || !b.lng || !b.lat) return 0;
  var R = 6371, dLat = (b.lat - a.lat) * Math.PI / 180, dLng = (b.lng - a.lng) * Math.PI / 180;
  var s = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(a.lat * Math.PI/180) * Math.cos(b.lat * Math.PI/180) *
    Math.sin(dLng/2) * Math.sin(dLng/2);
  return R * 2 * Math.atan2(Math.sqrt(s), Math.sqrt(1 - s));
}
function fmtKm(km){
  if(km < 1) return Math.round(km * 1000) + 'm';
  return km.toFixed(1) + 'km';
}

/* 新预估（曹操预估 + 服务费） */
function estimateNew(pu, dst, carType){
  var km = distKm(pu, dst);
  var rate = TX_RATES[carType] || 2.3;
  var flag = TX_FLAG[carType] || 10;
  var cao = Math.max(flag, flag + km * rate);
  var svc = +(cao * 0.1).toFixed(1);
  return { km:km, minutes: Math.max(5, Math.round(km * 2.6)), cao:+cao.toFixed(1), svc:svc,
    total:+(cao + svc).toFixed(1) };
}

