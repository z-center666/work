      '新预估：' + fmtMoney(p.est.total) + '（' + fmtPoints(p.est.total) + '） · 差额 ' +
      (p.delta > 0 ? '需追加冻结 ' + fmtPoints(p.delta)
        : p.delta < 0 ? '解冻 ' + fmtPoints(-p.delta) : '0') +
      '<div class="sim-row">' +
        '<button class="sim-ok" id="simDestOk">模拟老外确认</button>' +
        '<button class="sim-no" id="simDestNo">模拟老外拒绝</button>' +
      '</div>' +
    '</div>';

  $('simDestOk').onclick = function(){
    o.tDestPending = false;
    o.tDest = p.dest;
    o.summary = o.tPickup.zh + ' → ' + p.dest.zh;
    o.tEst = {cao: p.est.cao, svc: p.est.svc};
    o.money = {goods: p.est.cao, delivery: 0, service: p.est.svc, total: p.est.total};
    if(o.tFrozen < p.est.total){
      o.tDebt = +(o.tDebt + (p.est.total - o.tFrozen)).toFixed(1);
      o.tLogs.push({tm: nowStr(), operator:'系统', action:'改目的地后预估超出冻结，超出 ' + fmtPoints(p.est.total - o.tFrozen) + ' 挂欠账'});
    }
    o.tFrozen = Math.max(o.tFrozen, p.est.total);
    o.tPointLogs.push({tm: nowStr(), type:'冻结', amount: p.delta > 0 ? p.delta : 0,
      note:'改目的地后按新预估冻结（' + p.dest.zh + '）', operator:'系统'});
    o.tLogs.push({tm: nowStr(), operator:'老外', action:'老外确认改目的地：' + p.dest.zh});
    o.tDestProposal = null; o.tDestMsg = null;
    hideSheet();
    toast('老外已确认改目的地，行程已更新', true);
    renderList();
    if(state.detailId === o.id) renderDetail(o.id);
  };
  $('simDestNo').onclick = function(){
    o.tDestPending = false;
    o.tDestProposal = null; o.tDestMsg = null;
    o.tLogs.push({tm: nowStr(), operator:'老外', action:'老外拒绝改目的地请求'});
    hideSheet();
    toast('老外已拒绝改目的地，行程保持不变');
    renderList();
    if(state.detailId === o.id) renderDetail(o.id);
  };
}

/* ---------- 详情 ---------- */
function openDetail(id){
  state.detailId = id;
  renderDetail(id);
  $('viewList').hidden = true;
  $('viewDetail').hidden = false;
  $('detailBar').hidden = false;
  window.scrollTo(0, 0);
}
$('btnBack').addEventListener('click', function(){
  state.detailId = null;
  $('viewDetail').hidden = true;
  $('detailBar').hidden = true;
  $('viewList').hidden = false;
  renderList();
});

function kv(k, v){
  return '<div class="kv"><span class="k">' + k + '</span><span class="v">' + v + '</span></div>';
}

/* 路线 SVG */
function routeSvg(o){
  var a = o.tPickup, b = o.tDest;
  var minLng = Math.min(a.lng, b.lng), maxLng = Math.max(a.lng, b.lng);
  var minLat = Math.min(a.lat, b.lat), maxLat = Math.max(a.lat, b.lat);
  var padLng = Math.max((maxLng - minLng) * 0.2, 0.005), padLat = Math.max((maxLat - minLat) * 0.2, 0.005);
  minLng -= padLng; maxLng += padLng; minLat -= padLat; maxLat += padLat;
  function X(lng){ return ((lng - minLng) / (maxLng - minLng) * 100).toFixed(2); }
  function Y(lat){ return ((maxLat - lat) / (maxLat - minLat) * 100).toFixed(2); }
  var x1 = X(a.lng), y1 = Y(a.lat), x2 = X(b.lng), y2 = Y(b.lat);
  var mx = ((+x1 + +x2) / 2).toFixed(2), my = ((+y1 + +y2) / 2).toFixed(2);
  /* 曲线路径 */
  var dx = +x2 - +x1, dy = +y2 - +y1;
  var len = Math.sqrt(dx*dx + dy*dy) || 1;
  var nx = -dy / len, ny = dx / len;
  var cx = (+mx + nx * 10).toFixed(2), cy = (+my + ny * 10).toFixed(2);
  var dist = fmtKm(distKm(a, b));

  return '<div class="map-box">' +
    '<div class="map-grid"></div>' +
    '<svg class="map-route" viewBox="0 0 100 100" preserveAspectRatio="none">' +
      '<path d="M ' + x1 + ' ' + y1 + ' Q ' + cx + ' ' + cy + ' ' + x2 + ' ' + y2 + '" ' +
        'fill="none" stroke="#0669FF" stroke-width="1.2" stroke-dasharray="3 2" stroke-linecap="round"/>' +
      '<circle cx="' + x1 + '" cy="' + y1 + '" r="1.6" fill="#52C41A"/>' +
      '<circle cx="' + x2 + '" cy="' + y2 + '" r="1.6" fill="#0669FF"/>' +
    '</svg>' +
    '<div class="map-dot pu" style="left:calc(' + x1 + '% - 6px);top:calc(' + y1 + '% - 6px)"><span class="lbl">起点</span></div>' +
    '<div class="map-dot dst" style="left:calc(' + x2 + '% - 6px);top:calc(' + y2 + '% - 6px)"><span class="lbl">终点</span></div>' +
    '<div style="position:absolute;left:50%;bottom:8px;transform:translateX(-50%);' +
      'background:rgba(24,144,255,.9);color:#fff;font-size:.64rem;padding:2px 10px;border-radius:999px">' +
      dist + '</div>' +
  '</div>';
}

function renderDetail(id){
  var o = getOrder(id);
  if(!o) return;
  var st = orderStatusLabel(o);
  var h = '';

  /* 状态卡片 */
  h += '<div class="card status-card">' +
    badge(st, true) +
    '<span class="oid mono">曹操订单号 ' + esc(o.tCaoNo) + '</span>' +
    '<span class="meta-line">来源：' + esc(o.tSource) + ' · 下单 ' + esc(o.tCreated) +
      ' · ' + esc(o.tCity) + '（' + esc(o.tCityCode) + '）</span>' +
  '</div>';

  /* 用户信息 */
  h += '<div class="card"><div class="card-t">老外用户</div>' +
    kv('姓名', esc(o.name)) +
    kv('语言', esc(o.lang)) +
    kv('护照号', esc(maskPassport(o.passport))) +
    kv('手机号', esc(maskPhone(o.phone))) +
    kv('设备号', esc(o.deviceNo)) +
    kv('当前积分余额', esc(o.balance)) +
  '</div>';

  /* 行程信息 */
  h += '<div class="card"><div class="card-t">行程信息</div>' +
    kv('车型', esc(o.tCarType) + ' · ' + esc(o.merchant)) +
    routeSvg(o) +
    '<div style="display:flex;gap:10px">' +
      '<div style="flex:1;background:#F6FFED;border:1px solid #D9F7BE;border-radius:10px;padding:10px">' +
        '<div style="font-size:.68rem;color:#389E0D;font-weight:700">起点</div>' +
        '<div style="font-size:.84rem;font-weight:600;margin-top:2px">' + esc(o.tPickup.zh) + '</div>' +
        '<div style="font-size:.68rem;color:#8C8C8C">' + esc(o.tPickup.en) + '</div>' +
      '</div>' +
      '<div style="flex:1;background:#F0F7FF;border:1px solid #D6E9FF;border-radius:10px;padding:10px">' +
        '<div style="font-size:.68rem;color:#0669FF;font-weight:700">终点</div>' +
        '<div style="font-size:.84rem;font-weight:600;margin-top:2px">' + esc(o.tDest.zh) + '</div>' +
        '<div style="font-size:.68rem;color:#8C8C8C">' + esc(o.tDest.en) + '</div>' +
      '</div>' +
    '</div>' +
  '</div>';

  /* 司机信息 */
  if(o.tDriver){
    var d = o.tDriver;
    h += '<div class="card"><div class="card-t">司机信息</div>' +
      '<div class="driver-card">' +
        '<div class="driver-avatar">' + esc(d.name.charAt(0)) + '</div>' +
        '<div class="driver-info">' +
          '<div class="driver-name">' + esc(d.name) + '</div>' +
          '<div class="driver-sub">' + esc(d.model) + ' · ' + esc(d.color) + '</div>' +
          '<div class="driver-stats">' +
            '<span class="driver-stat">⭐ ' + esc(d.score) + '</span>' +
            '<span class="driver-stat">' + esc(d.trips) + ' 单</span>' +
            '<span class="driver-stat">ETA ' + esc(String(d.eta)) + ' 分钟</span>' +
          '</div>' +
        '</div>' +
      '</div>' +
      kv('车牌号', '<b class="mono">' + esc(d.plate) + '</b>') +
      kv('虚拟号', esc(maskPhone(d.virtualPhone))) +
    '</div>';
  }

  /* 费用明细 */
  var estTotal = +(o.tEst.cao + o.tEst.svc).toFixed(1);
  h += '<div class="card"><div class="card-t">费用明细</div>' +
    '<div class="fee-row"><span>曹操预估价</span><span class="v">' + fmtMoney(o.tEst.cao) + '</span></div>' +
    '<div class="fee-row"><span>平台服务费</span><span class="v">' + fmtMoney(o.tEst.svc) + '</span></div>' +
    '<div class="fee-row total"><span>预估总价</span><span class="v">' + fmtMoney(estTotal) + '（' + fmtPoints(estTotal) + '）</span></div>';
  if(o.tBill){
    var billTotal = +(o.tBill.cao + o.tBill.svc).toFixed(1);
    h += '<div class="fee-row"><span>曹操实际账单</span><span class="v">' + fmtMoney(o.tBill.cao) + '</span></div>' +
      '<div class="fee-row"><span>平台服务费（实）</span><span class="v">' + fmtMoney(o.tBill.svc) + '</span></div>' +
      '<div class="fee-row total"><span>实付总价</span><span class="v">' + fmtMoney(billTotal) + '（' + fmtPoints(billTotal) + '）</span></div>';
  }
  h += '<div class="fee-row"><span>冻结积分</span><span class="v">' + fmtPoints(o.tFrozen) + '</span></div>';
  if(o.tDeducted) h += '<div class="fee-row"><span>实扣积分</span><span class="v" style="color:#D4380D">' + fmtPoints(o.tDeducted) + '</span></div>';
  if(o.tReleased) h += '<div class="fee-row"><span>已解冻</span><span class="v" style="color:#389E0D">+' + fmtPoints(o.tReleased) + '</span></div>';
  if(o.tDebt) h += '<div class="fee-row"><span>挂欠账</span><span class="v" style="color:#FF4D4F">' + fmtPoints(o.tDebt) + '</span></div>';
  h += '<div class="fee-note freeze">下单时按所选车型最高报价冻结 ' + fmtPoints(o.tFrozen) + '</div>';
  if(o.tDebt > 0) h += '<div class="fee-note debt">实付超出冻结，差额 ' + fmtPoints(o.tDebt) + ' 挂欠账（下次充值抵扣）</div>';
  if(o.tCancelFee > 0){
    h += '<div class="fee-note fee">取消费 ' + fmtPoints(o.tCancelFee) + ' 已计入本单</div>';
  }
  h += '</div>';

  /* 积分流水 */
  h += '<div class="card"><div class="card-t">积分流水</div>';
  if(o.tPointLogs && o.tPointLogs.length){
    o.tPointLogs.forEach(function(p){
      var tag = PT_TYPE_TAG[p.type] || {cls:'freeze', sign:0};
      var signTxt = tag.sign > 0 ? '+' : tag.sign < 0 ? '-' : '';
      h += '<div class="log-item">' +
        '<span class="log-tm" style="width:auto;font-size:.68rem;white-space:nowrap">' + esc(p.tm) + '</span>' +
        '<span class="pt-tag ' + tag.cls + '">' + esc(p.type) + '</span>' +
        '<span class="log-txt"><b>' + signTxt + fmtPoints(p.amount) + '</b><br>' + esc(p.note) + '</span>' +
        '<span class="log-op">' + esc(p.operator) + '</span>' +
      '</div>';
    });
  }else{
    h += '<div class="comp-empty">暂无积分流水</div>';
  }
  h += '</div>';

  /* 曹操事件流水 */
  h += '<div class="card"><div class="card-t">曹操事件流水</div>';
  if(o.tEvents && o.tEvents.length){
    o.tEvents.forEach(function(ev){
      h += '<div class="ev-item">' +
        '<span class="ev-code">' + esc(String(ev.code)) + '</span>' +
        '<span class="ev-txt">' + esc(ev.label) + '</span>' +
        '<span class="ev-tm">' + esc(ev.tm) + '</span>' +
      '</div>';
    });
  }else{
    h += '<div class="comp-empty">暂无事件</div>';
  }
  h += '</div>';

  /* 操作日志 */
  h += '<div class="card"><div class="card-t">操作日志</div>';
  if(o.tLogs && o.tLogs.length){
    o.tLogs.forEach(function(l){
      h += '<div class="log-item">' +
        '<span class="log-tm" style="width:auto;font-size:.68rem;white-space:nowrap">' + esc(l.tm) + '</span>' +
        '<span class="log-txt">' + esc(l.action) + '</span>' +
        '<span class="log-op">' + esc(l.operator) + '</span>' +
      '</div>';
    });
  }else{
    h += '<div class="comp-empty">暂无操作日志</div>';
  }
  h += '</div>';

  /* 取消原因 */
  if(o.tCancelReason){
    h += '<div class="card"><div class="card-t">取消原因</div>' +
      '<div style="font-size:.8rem;color:#595959;background:#FAFAFA;border:1px solid #F0F0F0;border-radius:10px;padding:10px 12px">' +
        esc(o.tCancelReason) + '</div></div>';
  }

  /* 待确认提示 */
  if(o.tCancelPending && o.tCancelMsg){
    h += '<div class="card"><div class="card-t">待老外确认</div>' +
      '<div class="pending-box">⏳ <b>取消订单待老外确认</b><br>原因：' + esc(o.tCancelMsg.reason) +
      '<br>取消费：<b>' + fmtPoints(o.tCancelMsg.fee) + '</b></div></div>';
  }
  if(o.tDestPending && o.tDestMsg){
    h += '<div class="card"><div class="card-t">待老外确认</div>' +
      '<div class="pending-box">⏳ <b>改目的地待老外确认</b><br>新目的地：' + esc(o.tDestMsg.dest.zh) +
      '<br>新预估：' + fmtMoney(o.tDestMsg.est.total) + '（差额 ' + fmtPoints(o.tDestMsg.delta) + '）</div></div>';
  }

  $('detailBody').innerHTML = h;
  renderDetailBar(o);
}

/* 详情底部操作栏 */
function renderDetailBar(o){
  var bar = $('detailBar');
  var showCancel = canCancel(o);
  var showDest = canChangeDest(o);
  var html =
    '<button class="btn-ghost" id="dRefresh">刷新状态</button>';
  if(showCancel){
    html += '<button class="btn-danger" id="dCancel">取消</button>';
  }
  if(showDest){
    html += '<button class="btn-change" id="dDest">改目的地</button>';
  }
  html += '<button class="btn-push btn-primary" id="dPush">推送订单</button>';
  bar.innerHTML = html;

  $('dRefresh').addEventListener('click', function(){
    var btn = this;
    if(btn._busy) return;
    btn._busy = true;
    btn.classList.add('busy');
    var old = btn.textContent;
    btn.textContent = '刷新中…';
    setTimeout(function(){
      btn.classList.remove('busy');
      btn.textContent = old;
      btn._busy = false;
      toast('订单状态已刷新', true);
      if(state.detailId) renderDetail(state.detailId);
    }, 1200);
  });
  if(showCancel){
    $('dCancel').addEventListener('click', function(){ openCancelSheet(o.id); });
  }
  if(showDest){
    $('dDest').addEventListener('click', function(){ openDestSheet(o.id); });
  }
  $('dPush').addEventListener('click', function(){ doPush(this); });
}

/* ---------- 初始化 ---------- */
renderList();
</script>
